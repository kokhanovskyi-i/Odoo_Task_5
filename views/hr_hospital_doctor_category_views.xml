<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_hospital_doctor_category_list" model="ir.ui.view">
        <field name="name">hospital.doctor.category.list</field>
        <field name="model">hospital.doctor.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_hospital_doctor_category_form" model="ir.ui.view">
        <field name="name">hospital.doctor.category.form</field>
        <field name="model">hospital.doctor.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                    </group>

                    <notebook>
                        <page string="Doctors">
                            <field name="doctor_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="specialty"/>
                                    <field name="email"/>
                                    <field name="phone"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hospital_doctor_category" model="ir.actions.act_window">
        <field name="name">Doctor Categories</field>
        <field name="res_model">hospital.doctor.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>