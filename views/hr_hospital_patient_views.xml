<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_hr_hospital_patient_list" model="ir.ui.view">
        <field name="name">hr.hospital.patient.list</field>
        <field name="model">hr.hospital.patient</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="birth_date"/>
                <field name="age"/>
                <field name="gender"/>
                <field name="blood_type"/>
                <field name="personal_doctor_id"/>
                <field name="insurance_policy_number"/>
                <field name="email"/>
                <field name="phone"/>
            </list>
        </field>
    </record>

    <record id="view_hr_hospital_patient_form" model="ir.ui.view">
        <field name="name">hr.hospital.patient.form</field>
        <field name="model">hr.hospital.patient</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_appointment"
                            string="Create Visit"
                            type="object"
                            class="btn-primary"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_appointments"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-calendar">
                            <field name="appointment_count"
                                   widget="statinfo"
                                   string="Visits"/>
                        </button>
                    </div>

                    <group>
                        <group string="General Information">
                            <field name="name"/>
                            <field name="birth_date"/>
                            <field name="age"/>
                            <field name="gender"/>
                            <field name="blood_type"/>
                        </group>

                        <group string="Contacts">
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="insurance_policy_number"/>
                        </group>
                    </group>

                    <group string="Doctors">
                        <field name="personal_doctor_id"/>
                    </group>

                    <notebook>
                        <page string="Personal Doctor History">
                            <field name="doctor_history_ids">
                                <list editable="bottom">
                                    <field name="doctor_id"/>
                                    <field name="assignment_date"/>
                                    <field name="doctor_change_date"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_hospital_patient_search" model="ir.ui.view">
        <field name="name">hr.hospital.patient.search</field>
        <field name="model">hr.hospital.patient</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"
                       string="Patient Name"
                       filter_domain="[('name', 'ilike', self)]"/>

                <field name="phone"
                       string="Phone"
                       filter_domain="[('phone', 'ilike', self)]"/>

                <field name="personal_doctor_id"/>

                <separator/>

                <filter name="group_by_personal_doctor"
                        string="Personal Doctor"
                        context="{'group_by': 'personal_doctor_id'}"/>

                <filter name="group_by_gender"
                        string="Gender"
                        context="{'group_by': 'gender'}"/>
            </search>
        </field>
    </record>

    <record id="action_hr_hospital_patient" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">hr.hospital.patient</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hr_hospital_patient_search"/>
    </record>
</odoo>