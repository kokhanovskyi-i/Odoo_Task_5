<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="paperformat_hr_hospital_doctor_report_a4" model="report.paperformat">
        <field name="name">HR Hospital Doctor Report A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">15</field>
        <field name="margin_bottom">18</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">10</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_hr_hospital_doctor" model="ir.actions.report">
        <field name="name">Doctor Report</field>
        <field name="model">hr.hospital.doctor</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hr_hospital.report_doctor_document</field>
        <field name="report_file">hr_hospital.report_doctor_document</field>
        <field name="binding_model_id" ref="model_hr_hospital_doctor"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="hr_hospital.paperformat_hr_hospital_doctor_report_a4"/>
        <field name="print_report_name">'Doctor Report - %s' % object.name</field>
    </record>
</odoo>