<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_hr_hospital_disease_list" model="ir.ui.view">
        <field name="name">hr.hospital.disease.list</field>
        <field name="model">hr.hospital.disease</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="parent_id"/>
            </list>
        </field>
    </record>

    <record id="view_hr_hospital_disease_form" model="ir.ui.view">
        <field name="name">hr.hospital.disease.form</field>
        <field name="model">hr.hospital.disease</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Disease Information">
                            <field name="code"/>
                            <field name="name"/>
                            <field name="parent_id"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Child Diseases">
                            <field name="child_ids">
                                <list editable="bottom">
                                    <field name="code"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_hospital_disease_search" model="ir.ui.view">
        <field name="name">hr.hospital.disease.search</field>
        <field name="model">hr.hospital.disease</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"
                       string="Disease"
                       filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>

                <field name="parent_id"/>

                <separator/>

                <filter name="root_diseases"
                        string="Root Diseases"
                        domain="[('parent_id', '=', False)]"/>

                <filter name="child_diseases"
                        string="Child Diseases"
                        domain="[('parent_id', '!=', False)]"/>

                <separator/>

                <filter name="group_by_parent"
                        string="Parent Disease"
                        context="{'group_by': 'parent_id'}"/>

                <searchpanel>
                    <field name="parent_id"
                           string="Disease Hierarchy"
                           select="one"
                           hierarchize="1"
                           enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_hr_hospital_disease" model="ir.actions.act_window">
        <field name="name">Diseases</field>
        <field name="res_model">hr.hospital.disease</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hr_hospital_disease_search"/>
    </record>
</odoo>