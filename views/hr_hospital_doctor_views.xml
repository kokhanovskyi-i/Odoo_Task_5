<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_hr_hospital_doctor_list" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.list</field>
        <field name="model">hr.hospital.doctor</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="specialty"/>
                <field name="category_id"/>
                <field name="is_intern"/>
                <field name="mentor_id"/>
                <field name="user_id"/>
                <field name="birth_date"/>
                <field name="age"/>
                <field name="gender"/>
                <field name="blood_type"/>
                <field name="email"/>
                <field name="phone"/>
            </list>
        </field>
    </record>

    <record id="view_hr_hospital_doctor_form" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.form</field>
        <field name="model">hr.hospital.doctor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="General Information">
                            <field name="name"/>
                            <field name="specialty"/>
                            <field name="category_id"/>
                            <field name="is_intern"/>
                            <field name="mentor_id"
                                   invisible="not is_intern"
                                   domain="[('is_intern', '=', False)]"/>
                            <field name="user_id"/>
                        </group>

                        <group string="Medical Information">
                            <field name="birth_date"/>
                            <field name="age"/>
                            <field name="gender"/>
                            <field name="blood_type"/>
                        </group>
                    </group>

                    <group string="Contacts">
                        <field name="email"/>
                        <field name="phone"/>
                    </group>

                    <group string="Mentor Information" invisible="not mentor_id">
                        <field name="mentor_id"
                               readonly="1"
                               string="Mentor"/>
                    </group>

                    <notebook>
                        <page string="Interns">
                            <field name="intern_ids" mode="kanban" readonly="1">
                                <kanban>
                                    <field name="name"/>
                                    <field name="specialty"/>
                                    <field name="category_id"/>
                                    <field name="email"/>
                                    <field name="phone"/>
                                    <templates>
                                        <t t-name="card">
                                            <main>
                                                <field class="fw-bold fs-5" name="name"/>
                                                <div>
                                                    <span>Specialty: </span>
                                                    <field name="specialty"/>
                                                </div>
                                                <div>
                                                    <span>Category: </span>
                                                    <field name="category_id"/>
                                                </div>
                                                <div>
                                                    <span>Email: </span>
                                                    <field name="email"/>
                                                </div>
                                                <div>
                                                    <span>Phone: </span>
                                                    <field name="phone"/>
                                                </div>
                                            </main>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_hospital_doctor_search" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.search</field>
        <field name="model">hr.hospital.doctor</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"
                       string="Doctor"
                       filter_domain="['|', ('name', 'ilike', self), ('specialty', 'ilike', self)]"/>

                <field name="category_id"/>
                <field name="mentor_id"/>
                <field name="user_id"/>

                <separator/>

                <filter name="mentors"
                        string="Mentors"
                        domain="[('intern_ids', '!=', False)]"/>

                <filter name="interns"
                        string="Interns"
                        domain="[('is_intern', '=', True)]"/>

                <separator/>

                <filter name="group_by_category"
                        string="Category"
                        context="{'group_by': 'category_id'}"/>

                <filter name="group_by_mentor"
                        string="Mentor"
                        context="{'group_by': 'mentor_id'}"/>

                <filter name="group_by_is_intern"
                        string="Intern Status"
                        context="{'group_by': 'is_intern'}"/>
            </search>
        </field>
    </record>

    <record id="view_hr_hospital_doctor_kanban" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.kanban</field>
        <field name="model">hr.hospital.doctor</field>
        <field name="arch" type="xml">
            <kanban default_group_by="category_id"
                    class="o_kanban_mobile">
                <field name="name"/>
                <field name="specialty"/>
                <field name="category_id"/>
                <field name="is_intern"/>
                <field name="mentor_id"/>
                <field name="intern_names"/>
                <field name="email"/>
                <field name="phone"/>

                <templates>
                    <t t-name="menu">
                        <a type="open"
                           class="dropdown-item">
                            Open
                        </a>

                        <a type="delete"
                           class="dropdown-item">
                            Delete
                        </a>
                    </t>

                    <t t-name="card">
                        <main>
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <field class="fw-bold fs-5" name="name"/>

                                    <div class="mt-1">
                                        <span>Qualification: </span>
                                        <field name="category_id"/>
                                    </div>

                                    <div>
                                        <span>Specialty: </span>
                                        <field name="specialty"/>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-2" invisible="not is_intern">
                                <span class="badge text-bg-info">Intern</span>
                            </div>

                            <div class="mt-2" invisible="not mentor_id">
                                <span>Mentor: </span>
                                <field name="mentor_id"/>
                            </div>

                            <div class="mt-2" invisible="not intern_names">
                                <strong>Interns:</strong>
                                <div>
                                    <field name="intern_names"/>
                                </div>
                            </div>

                            <div class="mt-2">
                                <div invisible="not email">
                                    <span>Email: </span>
                                    <field name="email"/>
                                </div>

                                <div invisible="not phone">
                                    <span>Phone: </span>
                                    <field name="phone"/>
                                </div>
                            </div>
                        </main>

                        <footer>
                            <button name="action_create_appointment"
                                    type="object"
                                    class="btn btn-primary btn-sm">
                                Create Visit
                            </button>

                            <a type="open"
                               role="button"
                               class="btn btn-secondary btn-sm">
                                Open
                            </a>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_hr_hospital_doctor" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="res_model">hr.hospital.doctor</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_hr_hospital_doctor_search"/>
        <field name="context">{'group_by': 'category_id'}</field>
    </record>
</odoo>